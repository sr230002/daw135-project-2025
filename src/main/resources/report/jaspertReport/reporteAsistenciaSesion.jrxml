<jasperReport name="reporteAsistenciaSesion" language="java" pageWidth="612" pageHeight="792" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="2db00ba6-949e-455e-bad8-76974a93ff38">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DAW"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="evento_programacion_id" class="java.lang.Long"/>
	<query language="sql"><![CDATA[SELECT
    e.titulo AS evento_titulo,
    e.descripcion AS evento_descripcion,
    e.codigo AS evento_codigo,
    e.fecha_inicio AS evento_fecha_inicio,
    e.fecha_fin AS evento_fecha_fin,
    et.descripcion AS tipo_evento_nombre,
    adj.url AS adjunto_ruta,
    ep.fecha_programacion AS programacion_fecha,
    ep.hora_inicio AS programacion_hora_inicio,
    ep.hora_fin AS programacion_hora_fin,
    ep.virtual AS programacion_virtual,
    ep.lugar AS programacion_lugar,
    ep.enlace AS programacion_enlace,
    ep.cupos AS programacion_cupos,
    p.nombre AS ponente_nombre,
    er.fecha_creacion AS registro_fecha_creacion,
    u.nombre AS participante_nombre,
    u.correo AS participante_correo,
    er.asistencia_confirmada AS participante_asistencia_confirmada
FROM
    ema.evento_programacion ep
JOIN
    ema.evento e ON ep.evento_id = e.evento_id
LEFT JOIN
    ema.evento_tipo et ON e.evento_tipo_id = et.evento_tipo_id
LEFT JOIN
    ema.adjunto adj ON e.adjunto_id = adj.adjunto_id
LEFT JOIN
    sec.usuario p ON ep.ponente_id = p.usuario_id
LEFT JOIN
    ema.evento_registro er ON ep.evento_programacion_id = er.evento_programacion_id
LEFT JOIN
    sec.usuario u ON er.participante_id = u.usuario_id
WHERE
    ep.evento_programacion_id = $P{evento_programacion_id}
ORDER BY
    u.nombre]]></query>
